<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & Version Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NativeAnalyticsEngine Explorer"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v1.0.4 • Layer 2 Domain Engine • Production Ready"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:paddingBottom="12dp" />

        <!-- Engine Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ENGINE DASHBOARD"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#38BDF8"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: INITIALIZING..."
                android:textSize="15sp"
                android:textColor="#34D399"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Subsystems: SessionTracker • PerformanceTracker • BatchUploader • DiskBuffer"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Control Action Buttons Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANALYTICS CONTROLS"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#38BDF8"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btn_init"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Initialize Engine"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_track_event"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Track Event"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_record_metric"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Record Metric"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_trace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Run Trace Test"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_session"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Toggle Session"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_flush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flush Telemetry"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Runtime Event Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RUNTIME TELEMETRY LOG"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="12sp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#020617"
                android:textColor="#E2E8F0"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:padding="10dp"
                android:scrollbars="vertical"
                android:text="[Console Ready] Waiting for telemetry events...\n" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>